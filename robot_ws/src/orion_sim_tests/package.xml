<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>orion_sim_tests</name>
  <version>0.1.0</version>
  <description>Headless Gazebo smoke tests: the rover spawns, its controllers come up, it drives, the e-stop stops it through twist_mux, and Nav2 reaches a goal.</description>
  <maintainer email="suhasacharya0525@gmail.com">Suhas</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>nav_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>nav2_msgs</test_depend>
  <test_depend>tf2_ros_py</test_depend>
  <test_depend>std_srvs</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>orion_msgs</test_depend>
  <test_depend>orion_safety</test_depend>
  <test_depend>orion_policy</test_depend>
  <test_depend>orion_bringup</test_depend>
  <!-- test_policy_onnx also needs pip-only torch, onnx and orion_learning
       (orion_policy/requirements.txt, scripts/ci_pip_deps.sh). -->
  <test_depend>navigation2</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
