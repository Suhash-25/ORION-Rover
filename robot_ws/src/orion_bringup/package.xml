<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>orion_bringup</name>
  <version>1.0.0</version>

  <description>
    Bringup package for the ORION Autonomous Rover.
    Launches the complete robot including visualization,
    simulation and future runtime components.
  </description>

  <maintainer email="suhasacharya0525@gmail.com">
    Suhas
  </maintainer>

  <license>MIT</license>

  <!-- Build Tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime Dependencies -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <exec_depend>orion_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
