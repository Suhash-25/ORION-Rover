<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>orion_ground_truth</name>
  <version>0.1.0</version>
  <description>Sandbox ground truth for ORION: overhead camera + AprilTags to /orion/ground_truth_pose.</description>
  <maintainer email="suhasacharya0525@gmail.com">Suhas</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros_py</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>apriltag_ros</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>image_proc</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
