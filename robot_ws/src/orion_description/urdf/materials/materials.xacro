<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ========================================================= -->
    <!--                  ORION Material Library                   -->
    <!-- ========================================================= -->

    <!-- Main Chassis -->
    <material name="orion_silver">
        <color rgba="0.75 0.75 0.75 1.0"/>
    </material>

    <!-- Wheels -->
    <material name="wheel_black">
        <color rgba="0.10 0.10 0.10 1.0"/>
    </material>

    <!-- Sensor Mast -->
    <material name="mast_gray">
        <color rgba="0.55 0.55 0.55 1.0"/>
    </material>

    <!-- LiDAR -->
    <material name="lidar_dark">
        <color rgba="0.20 0.20 0.20 1.0"/>
    </material>

    <!-- RGB Camera -->
    <material name="camera_blue">
        <color rgba="0.15 0.30 0.85 1.0"/>
    </material>

    <!-- 360 Camera -->
    <material name="camera360_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
    </material>

    <!-- Ground Truth Marker -->
    <material name="debug_red">
        <color rgba="1.0 0.0 0.0 1.0"/>
    </material>

    <!-- Transparent Sensor Visualization -->
    <material name="transparent">
        <color rgba="1.0 1.0 1.0 0.25"/>
    </material>
</robot>
