<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================= -->
  <!--                    ORION 2D LiDAR                         -->
  <!-- ========================================================= -->

  <xacro:macro
      name="orion_lidar"
      params="parent_link">

    <!-- ================= LiDAR Link ================= -->

    <link name="lidar_link">

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>

        <geometry>
          <cylinder radius="0.04" length="0.05"/>
        </geometry>

        <material name="orion_black"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>

        <geometry>
          <cylinder radius="0.04" length="0.05"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0"/>

        <mass value="0.20"/>

        <inertia
          ixx="0.0002"
          ixy="0"
          ixz="0"
          iyy="0.0002"
          iyz="0"
          izz="0.0002"/>
      </inertial>

    </link>

    <!-- ================= Mount Joint ================= -->

    <joint
        name="lidar_joint"
        type="fixed">

      <parent link="${parent_link}"/>
      <child link="lidar_link"/>

      <!-- Mounted on top of the mast -->
      <origin
          xyz="0 0 0.15"
          rpy="0 0 0"/>

    </joint>

  </xacro:macro>

</robot>
