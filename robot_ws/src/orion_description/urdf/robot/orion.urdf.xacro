<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="orion">

    <!-- ========================================================= -->
    <!--                 ORION Robot Assembly                      -->
    <!-- ========================================================= -->

    <!-- Common Definitions -->
    <xacro:include filename="../common/constants.xacro"/>

    <!-- Material Library -->
    <xacro:include filename="../materials/materials.xacro"/>

    <!-- Robot Components -->
    <xacro:include filename="../links/chassis.xacro"/>
    <xacro:include filename="../links/mast.xacro"/>
    <xacro:include filename="../links/wheel.xacro"/>

    <!-- Assemble ORION -->
    <xacro:orion_chassis/>
    <xacro:orion_mast/>
    <xacro:orion_wheel
    wheel_name="front_left_wheel"
    parent_link="base_link"
    x="${wheel_x}"
    y="${wheel_y}"
    z="${wheel_radius}"/>
   
   <xacro:orion_wheel
    wheel_name="front_right_wheel"
    parent_link="base_link"
    x="${wheel_x}"
    y="${-wheel_y}"
    z="${wheel_radius}"/>

   <xacro:orion_wheel
    wheel_name="rear_left_wheel"
    parent_link="base_link"
    x="${-wheel_x}"
    y="${wheel_y}"
    z="${wheel_radius}"/>

    <xacro:orion_wheel
    wheel_name="rear_right_wheel"
    parent_link="base_link"
    x="${-wheel_x}"
    y="${-wheel_y}"
    z="${wheel_radius}"/>

</robot>
