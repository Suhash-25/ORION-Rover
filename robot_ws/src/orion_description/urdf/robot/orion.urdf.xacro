<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="orion">

    <!-- ========================================================= -->
    <!--                  ORION Robot Assembly                     -->
    <!-- ========================================================= -->

    <!-- Common Constants -->
    <xacro:include filename="../common/constants.xacro"/>

    <!-- Materials -->
    <xacro:include filename="../materials/materials.xacro"/>

    <!-- Robot Components -->
    <xacro:include filename="../links/chassis.xacro"/>
    <xacro:include filename="../links/mast.xacro"/>
    <xacro:include filename="../links/wheel.xacro"/>

    <!-- ROS2 Control -->
    <xacro:include filename="../control/ros2_control.xacro"/>
    <xacro:include filename="../gazebo/gazebo_control.xacro"/>
 
    <!-- ========================================================= -->
    <!--                    Build the Robot                        -->
    <!-- ========================================================= -->

    <!-- Chassis -->
    <xacro:orion_chassis/>

    <!-- Sensor Mast -->
    <xacro:orion_mast/>

    <!-- ================= Front Left Wheel ================= -->

    <xacro:orion_wheel
        wheel_name="front_left_wheel"
        parent_link="base_link"
        x="${wheel_x}"
        y="${wheel_y}"
        z="${wheel_radius}"/>

    <!-- ================= Front Right Wheel ================= -->

    <xacro:orion_wheel
        wheel_name="front_right_wheel"
        parent_link="base_link"
        x="${wheel_x}"
        y="${-wheel_y}"
        z="${wheel_radius}"/>

    <!-- ================= Rear Left Wheel ================= -->

    <xacro:orion_wheel
        wheel_name="rear_left_wheel"
        parent_link="base_link"
        x="${-wheel_x}"
        y="${wheel_y}"
        z="${wheel_radius}"/>

    <!-- ================= Rear Right Wheel ================= -->

    <xacro:orion_wheel
        wheel_name="rear_right_wheel"
        parent_link="base_link"
        x="${-wheel_x}"
        y="${-wheel_y}"
        z="${wheel_radius}"/>

    <!-- ========================================================= -->
    <!--                    ROS2 Control                           -->
    <!-- ========================================================= -->

    <xacro:orion_ros2_control/>
    <xacro:orion_gazebo_control/>
   
</robot>
