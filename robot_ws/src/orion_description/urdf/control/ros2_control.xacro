<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================= -->
  <!--                  ORION ROS2 Control Macro                 -->
  <!-- ========================================================= -->

  <!-- hardware:=gazebo (default) uses gz_ros2_control in simulation.
       hardware:=serial drives the real rover through orion_hardware/OrionSystem and the wheel
       firmware (docs/PROTOCOL.md). The drive-train values below are GUESSES until the hardware
       inventory (docs/HARDWARE.md) is filled in; override them on the xacro command line, e.g.
         xacro orion.urdf.xacro hardware:=serial port:=/dev/ttyACM0 encoder_cpr:=2048 -->
  <xacro:arg name="hardware" default="gazebo"/>
  <xacro:arg name="port" default="/dev/ttyACM0"/>
  <xacro:arg name="baud" default="921600"/>
  <!-- decoder counts per motor revolution, after x4 quadrature decoding (GUESS) -->
  <xacro:arg name="encoder_cpr" default="2048"/>
  <!-- motor revolutions per wheel revolution (GUESS) -->
  <xacro:arg name="gear_ratio" default="30"/>
  <!-- motor torque constant, N m/A at the motor shaft; 0 disables back-EMF correction of the
       duty-based current estimate (used only without current sensing) -->
  <xacro:arg name="kt" default="0.0"/>
  <!-- motor terminal resistance, ohm (GUESS) -->
  <xacro:arg name="motor_resistance" default="0.5"/>
  <xacro:arg name="brake_on_idle" default="false"/>
  <!-- bound (rad/s per wheel) of orion_msgs/WheelPerturbation on /orion/wheel_perturbation,
       the fault-injection hook; 0 = disabled (docs/INTERFACES.md) -->
  <xacro:arg name="perturbation_max_rad_s" default="0.0"/>

  <xacro:macro name="orion_ros2_control">

    <xacro:property name="hardware" value="$(arg hardware)"/>
    <xacro:if value="${hardware not in ['gazebo', 'serial']}">
      ${xacro.fatal("hardware must be 'gazebo' or 'serial', got '" + hardware + "'")}
    </xacro:if>

    <ros2_control
        name="orion_system"
        type="system">

      <hardware>

        <xacro:if value="${hardware == 'gazebo'}">
          <!-- Gazebo ros2_control Plugin -->
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>

        <xacro:if value="${hardware == 'serial'}">
          <!-- Real rover: wheel firmware over a serial link -->
          <plugin>orion_hardware/OrionSystem</plugin>
          <param name="port">$(arg port)</param>
          <param name="baud">$(arg baud)</param>
          <param name="encoder_cpr">$(arg encoder_cpr)</param>
          <param name="gear_ratio">$(arg gear_ratio)</param>
          <param name="kt">$(arg kt)</param>
          <param name="motor_resistance">$(arg motor_resistance)</param>
          <param name="brake_on_idle">$(arg brake_on_idle)</param>
          <param name="perturbation_max_rad_s">$(arg perturbation_max_rad_s)</param>
        </xacro:if>

      </hardware>

      <!-- Firmware wheel slots (motor_index) follow the protocol order FL FR RL RR. Set a
           joint's direction to -1 if its motor counts up when the wheel turns URDF-negative. -->

      <!-- ===================================================== -->
      <!--                Front Left Wheel Joint                 -->
      <!-- ===================================================== -->

      <joint name="front_left_wheel_joint">

        <xacro:if value="${hardware == 'serial'}">
          <param name="motor_index">0</param>
          <param name="direction">1</param>
        </xacro:if>

        <command_interface name="velocity"/>

        <state_interface name="position"/>

        <state_interface name="velocity"/>

        <!-- Motor effort: torque in sim, motor current (A) on the real rover, estimated from
             duty when the board has no current sensing (RoverHealth.current_sensed).
             orion_terrain uses it as the sinkage / bogging-down signal. -->
        <state_interface name="effort"/>

      </joint>

      <!-- ===================================================== -->
      <!--               Front Right Wheel Joint                 -->
      <!-- ===================================================== -->

      <joint name="front_right_wheel_joint">

        <xacro:if value="${hardware == 'serial'}">
          <param name="motor_index">1</param>
          <param name="direction">1</param>
        </xacro:if>

        <command_interface name="velocity"/>

        <state_interface name="position"/>

        <state_interface name="velocity"/>

        <state_interface name="effort"/>

      </joint>

      <!-- ===================================================== -->
      <!--                 Rear Left Wheel Joint                 -->
      <!-- ===================================================== -->

      <joint name="rear_left_wheel_joint">

        <xacro:if value="${hardware == 'serial'}">
          <param name="motor_index">2</param>
          <param name="direction">1</param>
        </xacro:if>

        <command_interface name="velocity"/>

        <state_interface name="position"/>

        <state_interface name="velocity"/>

        <state_interface name="effort"/>

      </joint>

      <!-- ===================================================== -->
      <!--                Rear Right Wheel Joint                 -->
      <!-- ===================================================== -->

      <joint name="rear_right_wheel_joint">

        <xacro:if value="${hardware == 'serial'}">
          <param name="motor_index">3</param>
          <param name="direction">1</param>
        </xacro:if>

        <command_interface name="velocity"/>

        <state_interface name="position"/>

        <state_interface name="velocity"/>

        <state_interface name="effort"/>

      </joint>

    </ros2_control>

  </xacro:macro>

</robot>
